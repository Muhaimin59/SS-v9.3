FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=0
SESSION_COOKIE_SECURE=1
SMARTSERVE_DB_PATH=/var/data/smartserve.db
SMARTSERVE_UPLOAD_FOLDER=/var/data/uploads
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-DOMAIN/auth/google/callback
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=SmartServe
APP_BASE_URL=http://127.0.0.1:5000

# Optional WhatsApp Cloud API for private SOS alerts to saved trusted contacts.
# Requires recipient opt-in and an approved WhatsApp message template.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_SOS_TEMPLATE_NAME=smartserve_sos_alert
WHATSAPP_SOS_TEMPLATE_LANGUAGE=en_US
SMARTSERVE_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# SmartServe V10 additions
# ---------------------------------------------------------------------------
# DEVELOPMENT ONLY phone OTP mode. When set to 1 the verification centre shows
# the 6-digit code on screen instead of sending an SMS. MUST stay 0 in
# production — never ship a deployment with SMARTSERVE_DEV_OTP=1.
SMARTSERVE_DEV_OTP=0

# Longest accepted phone number (digits). Registration requires at least 10.
SMARTSERVE_PHONE_MAX_DIGITS=15

# Transactional SMS provider used for phone verification and safety alerts.
# Any HTTP JSON API works: SmartServe POSTs {"to": "...", "message": "..."}.
# Without credentials phone verification fails closed (no fake verifications);
# use SMARTSERVE_DEV_OTP=1 for local development only.
SMS_PROVIDER_URL=
SMS_PROVIDER_KEY=
SMS_SENDER_ID=SMTSRV

# Lifetime of a phone OTP in minutes (default 10) and of an email verification
# link in minutes (default 30, signed and single-use).
SMARTSERVE_OTP_TTL_MINUTES=10
SMARTSERVE_EMAIL_TOKEN_MINUTES=30
